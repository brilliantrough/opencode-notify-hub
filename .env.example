# Gateway environment template — lists every required variable with a
# secret-free placeholder. Copy to .env (never commit it) and fill in real
# values, or pass the variables to the container runtime directly.

# PostgreSQL connection string (postgres:// or postgresql:// scheme).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/notify

# Canonical public https URL of the gateway API (how clients reach it
# through the reverse proxy).
PUBLIC_BASE_URL=https://notify.example.com

# Base64 decoding to at least 32 bytes. Generate with: openssl rand -base64 32
JWT_SIGNING_KEY=

# Outbound SMTP for verification / password-reset mail.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="OpenCode Notify <notify@example.com>"

# Required by the current gateway: Firebase service account as a single-line
# JSON object with non-empty project_id, client_email, and private_key fields.
# Use a development project locally and never commit the populated value.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Comma-separated absolute http(s) origins allowed for browser CORS and the
# WebSocket Origin check (no credentials, paths, queries, or fragments;
# matched exactly after normalization). Clients that send no Origin header —
# native apps — are always allowed.
ALLOWED_ORIGINS=https://app.example.com

# One of: fatal, error, warn, info, debug, trace, silent.
LOG_LEVEL=info

# Optional operational override for the listen port (default 8080); not one
# of the specification variables.
# PORT=8080
